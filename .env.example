# AFTER DARK — variables de entorno
# Copia este archivo como .env para desarrollo local.
# En Render configura estas variables en Environment.

NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/afterdark

# Sesiones del dashboard: usa una cadena larga y aleatoria (mínimo 32 caracteres).
SESSION_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Aplicación de Discord (Developer Portal)
DISCORD_TOKEN=token-del-bot
DISCORD_CLIENT_ID=id-de-la-aplicacion
DISCORD_CLIENT_SECRET=secreto-oauth-de-la-aplicacion

# IDs de los propietarios del bot separados por comas.
OWNER_IDS=123456789012345678

# Prefijo para comandos de texto (ejemplo: .work). Requiere Message Content Intent.
PREFIX=.
